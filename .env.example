# PostgreSQL (obrigatória)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Gere com: openssl rand -base64 48 (obrigatória, mínimo 32 caracteres)
JWT_SECRET=replace-with-a-long-random-secret

# MinIO/S3 (obrigatórias para upload e exibição de imagens)
MINIO_SERVER_URL=https://minio.example.com
MINIO_ROOT_USER=replace-me
MINIO_ROOT_PASSWORD=replace-me
MINIO_BUCKET=ternos

# URL pública do site, sem barra final
NEXT_PUBLIC_APP_URL=https://ternos.example.com

# Usadas somente por `npm run db:seed`; não são necessárias no runtime após o seed
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
